# SQLite database file. Relative paths resolve from the project directory.
# This is also the application default when DATABASE_URL is omitted.
DATABASE_URL=local.db

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
# Identikey OpenID Connect
# Register this callback URL: {ORIGIN}/api/auth/callback/identikey
IDENTIKEY_CLIENT_ID=""
# Optional for public PKCE clients
IDENTIKEY_CLIENT_SECRET=""
