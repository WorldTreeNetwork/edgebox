# Copy to site.env. Do not commit secrets.
EDGEBOX_HOSTNAME=edgebox
EDGEBOX_USER=duke
EDGEBOX_TIMEZONE=America/Los_Angeles
EDGEBOX_LOCALE=en_US.UTF-8
EDGEBOX_KEYMAP=us
EDGEBOX_LAN_INTERFACE=eth0

# A router-side DHCP reservation is preferred. For a device-side static
# address, set mode=static and provide all four values below.
EDGEBOX_NETWORK_MODE=dhcp
EDGEBOX_LAN_ADDRESS=
EDGEBOX_LAN_GATEWAY=
EDGEBOX_LAN_DNS=
EDGEBOX_LOCAL_DOMAIN=local

# Available profiles: core, apps, pxe. Profiles are comma-separated.
EDGEBOX_PROFILES=core,apps

# Optional existing filesystem. The provisioner never formats disks.
EDGEBOX_DATA_MOUNT=/Media
EDGEBOX_DATA_UUID=

# disabled, tftp-only, proxy, or authoritative. Authoritative requires the
# complete DHCP range below and explicit acknowledgement at build time.
EDGEBOX_PXE_MODE=disabled
EDGEBOX_PXE_DHCP_START=
EDGEBOX_PXE_DHCP_END=
EDGEBOX_PXE_NETMASK=
EDGEBOX_PXE_GATEWAY=
EDGEBOX_PXE_DNS=

# Public material is safe to inject. No private keys or passwords belong here.
EDGEBOX_SSH_PUBLIC_KEY=ssh-ed25519 REPLACE_ME
