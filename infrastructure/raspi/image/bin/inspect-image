#!/usr/bin/env bash
set -Eeuo pipefail

manifest=${1:-}
[[ -n "$manifest" && -r "$manifest" ]] || { printf 'Usage: inspect-image IMAGE.img.xz.manifest\n' >&2; exit 2; }
required=(format_version built_at base_url base_sha256 architecture profiles image image_sha256)
for key in "${required[@]}"; do
  grep -q "^$key=" "$manifest" || { printf 'missing manifest field: %s\n' "$key" >&2; exit 1; }
done
cat "$manifest"
