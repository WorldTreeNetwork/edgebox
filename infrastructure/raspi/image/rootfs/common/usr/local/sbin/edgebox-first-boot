#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

source /usr/local/lib/edgebox/common.sh
load_env_file /etc/edgebox/defaults.env
load_env_file /etc/edgebox/site.env
EDGEBOX_PROFILES=$(</etc/edgebox/profiles)
export EDGEBOX_PROFILES

mkdir -p /var/lib/edgebox/steps /var/log/edgebox
exec > >(tee -a /var/log/edgebox/first-boot.log) 2>&1

for step in identity packages network storage firewall pxe applications validate; do
  run_step "$step" "/usr/local/lib/edgebox/steps/$step.sh"
done

install -m 0600 /dev/null /var/lib/edgebox/first-boot.complete
bind_address=${EDGEBOX_LAN_ADDRESS%/*}
if [[ -z "$bind_address" ]]; then
  bind_address=$(ip -4 -o address show dev "$EDGEBOX_LAN_INTERFACE" scope global | awk 'NR==1 {split($4,a,"/"); print a[1]}')
fi
{
  printf 'Edgebox first boot completed successfully.\n'
  printf 'Host: %s\nProfiles: %s\nAddress: %s\n' "$EDGEBOX_HOSTNAME" "$EDGEBOX_PROFILES" "$bind_address"
  if profile_enabled apps; then
    printf 'Forgejo: http://%s:3000\n' "$bind_address"
    printf 'Vaultwarden bootstrap: http://%s:8222 (configure trusted HTTPS before use)\n' "$bind_address"
    printf 'Vikunja: http://%s:3456\n' "$bind_address"
    printf 'Stirling PDF: http://%s:8082\n' "$bind_address"
  fi
} > /var/lib/edgebox/install-report.txt
systemctl disable edgebox-first-boot.service
log "first-boot provisioning complete"
