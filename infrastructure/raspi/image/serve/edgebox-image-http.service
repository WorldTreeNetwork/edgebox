[Unit]
Description=Edgebox image download, GET-only face of the blob door
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mjolnir
Group=mjolnir
ExecStart=/usr/bin/python3 /opt/mjolnir/bin/edgebox-image-http
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mjolnir
PrivateTmp=true

[Install]
WantedBy=multi-user.target
